# Global Project Environment Variables Example

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password_123
POSTGRES_DB=chatdb
DATABASE_URL=postgresql://postgres:postgres_secure_password_123@postgres:5432/chatdb

# Redis
REDIS_URL=redis://redis:6379/0

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_replace_for_production_environment_987654321
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Application URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
VITE_API_URL=http://localhost:8000/api
VITE_WS_URL=ws://localhost:8000
